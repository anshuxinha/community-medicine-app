rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Package A: own-user field allowlist (premium fields still client-writable
    // until Package B server authority). Cross-user premium grant removed.
    // isAdmin is never client-writable (claims / Admin SDK only).
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminToken() {
      return isSignedIn() && request.auth.token.isAdmin == true;
    }

    // Fields the mobile client is allowed to create/update on users/{uid}.
    // Keep in sync with LoginScreen, AppContext, couponService, notificationService.
    function userClientKeys() {
      return [
        'email',
        'createdAt',
        'username',
        'appleUser',
        'currentDeviceId',
        'referralCode',
        'referredByCode',
        'referredByUid',
        'totalReferrals',
        // Premium: temporary until Package B (RevenueCat webhook / claims)
        'isPremium',
        'premiumUpdatedAt',
        'premiumSource',
        'premiumType',
        'premiumPlan',
        'premiumExpiryDate',
        'appliedCoupon',
        // Push + notifications
        'pushToken',
        'pushTokenUpdatedAt',
        'pushTokenPlatform',
        'videoNotificationsEnabled',
        'videoNotificationsUpdatedAt',
        // Learning progress
        'readItems',
        'readItemVersions',
        'bookmarks',
        'currentStreak',
        'lastReadDate',
        'dailyReadHistory',
        'studyScore',
        'deviceStates',
        'syncedAt',
        // Learning profile / onboarding (NMC paper focus)
        'onboardingCompleted',
        'learnerRole',
        'trainingYear',
        'preferredPaperFocus'
      ];
    }

    function onlyUserClientKeys() {
      return request.resource.data.keys().hasOnly(userClientKeys());
    }

    function onlyUserClientKeyDiff() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(userClientKeys());
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminToken();

      // Full-doc key check on create (new docs must not include isAdmin, etc.).
      allow create: if isOwner(userId) && onlyUserClientKeys();

      // Diff-only on update so pre-existing fields (e.g. legacy isAdmin set via
      // console) are preserved; clients still cannot change non-allowlisted keys.
      allow update: if isOwner(userId) && onlyUserClientKeyDiff();

      allow delete: if isOwner(userId);

      match /highlights/{contentKey} {
        allow read, write: if isOwner(userId);
      }

      match /annotations/{contentKey} {
        allow read, write: if isOwner(userId);
      }
    }

    match /libraryContentOverrides/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    match /libraryReviewSuggestions/{docId} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    match /libraryReviewMeta/{docId} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    match /videoDoubts/{doubtId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "under_review";
      allow delete: if request.auth != null
        && (request.auth.token.isAdmin == true || resource.data.userId == request.auth.uid);
      allow update: if request.auth != null
        && (
          request.auth.token.isAdmin == true
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorPushToken'])
          )
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotedBy', 'replies'])
        );
    }

    // --- Added for Coupons ---
    match /coupons/{couponId} {
      // Users need to read coupon details to validate them
      allow read: if request.auth != null;

      // Allow users to update ONLY the usageCount field during a purchase transaction
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']);

      // Admins have full control to create/delete coupons
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // --- Added for Topic Illustrations ---
    match /topicIllustrations/{docId} {
      // Authenticated users can read illustrations
      allow read: if request.auth != null;
      // Only admins can update or create illustrations
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // --- Added for Referrals ---
    match /referrals/{referralId} {
      allow read: if request.auth != null 
        && (resource == null || resource.data.referrerUid == request.auth.uid || resource.data.refereeUid == request.auth.uid);
      allow create: if request.auth != null 
        && (request.resource.data.refereeUid == request.auth.uid || request.resource.data.referrerUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.referrerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rewardGranted', 'status']);
    }

    // --- Added for Referral Codes registry ---
    match /referralCodes/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }

    // --- Added for App Config (Update checks) ---
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // --- App feedback from review "Not Really" path ---
    match /appFeedback/{docId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == "new";
      allow read, update, delete: if request.auth != null
        && request.auth.token.isAdmin == true;
    }
  }
}
